{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "appimage",
      "deb",
      "rpm"
    ],
    "resources": {
      "../target/release/lazo-hook.exe": null,
      "../target/release/lazo-hook": "lazo-hook",
      "../../lazo/bin/Lazo.exe": null,
      "../../engine/bin/Lazo.Engine.exe": null,
      "../../engine/tps2rin/tps2rin.exe": null
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "libgtk-layer-shell0 (>= 0.6)",
          "libasound2t64 | libasound2"
        ]
      },
      "rpm": {
        "depends": [
          "gtk-layer-shell",
          "alsa-lib"
        ]
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "island",
        "title": "Lazo",
        "url": "index.html",
        "width": 240,
        "height": 6,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "visibleOnAllWorkspaces": true,
        "visible": false,
        "center": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "dragDropEnabled": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ]
  }
}
